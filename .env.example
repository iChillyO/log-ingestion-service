# Application
PORT=8080
LOG_LEVEL=info

# PostgreSQL connection (used when running the app outside docker-compose)
DATABASE_URL=postgres://logs:logs@localhost:5432/logs

# Ingestion tuning
INGEST_MAX_BATCH=1000
INGEST_MAX_BODY_BYTES=5242880

# Retention
RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=300000
RETENTION_PARTITION_LOOKAHEAD_DAYS=2

# Optional features (default: disabled)
AUTH_ENABLED=false
# LOADGEN_API_KEY=change-me
