# Application
PORT=8080
LOG_LEVEL=info

# PostgreSQL connection (used when running the app outside docker-compose)
DATABASE_URL=postgres://logs:logs@localhost:5432/logs

# Ingestion tuning
INGEST_MAX_BATCH=1000
INGEST_MAX_BODY_BYTES=5242880

# Ingest pipeline (defaults shown; see README "Bottlenecks and optimisations")
INGEST_FLUSH_INTERVAL_MS=15
INGEST_FLUSH_MAX_ROWS=5000
INGEST_WRITERS=3
INGEST_MAX_BUFFERED_ROWS=120000
ROLLUP_FLUSH_INTERVAL_MS=200
PG_POOL_MAX=10

# Retention
RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=300000
RETENTION_PARTITION_LOOKAHEAD_DAYS=2

# Optional features (default: disabled)
AUTH_ENABLED=false
# LOADGEN_API_KEY=change-me
