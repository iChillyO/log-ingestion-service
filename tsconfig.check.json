// Type-checks everything the build tsconfig deliberately leaves out: the test
// suite and the load-test script. `tsconfig.json` cannot simply include them,
// because they must not end up in `dist/`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
